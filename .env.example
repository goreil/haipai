# Required — Flask session signing key. Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional — set to "development" for debug mode and non-secure cookies
# FLASK_ENV=development

# Optional — path to SQLite database (default: games.db in project root)
# DB_PATH=/app/data/games.db

# Optional — GitHub personal access token for creating issues from feedback
# GITHUB_TOKEN=ghp_...

# Optional — GitHub repo for issue creation (default: goreil/haipai-mahjong)
# GITHUB_REPO=goreil/haipai-mahjong

# Optional — Discord webhook URL for new feedback notifications
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Required for registration email verification — mailbox.org SMTP (smtp.mailbox.org:587)
# credentials. Without these, registration emails silently fail to send (logged
# to stderr) and new accounts stay stuck unverified until a resend succeeds.
# MAILBOX_USERNAME=you@mailbox.org
# MAILBOX_PASSWORD=

# Optional — visible From: address for verification emails, if different from
# MAILBOX_USERNAME (mailbox.org allows sending as an alias of the auth account).
# Defaults to MAILBOX_USERNAME.
# MAIL_FROM=noreply.haipai@yourdomain.example
