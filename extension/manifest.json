{
  "manifest_version": 3,
  "name": "mjai → haipai uploader",
  "version": "2.2.0",
  "description": "Uploads a Mortal review from mjai.ekyu.moe to your haipai instance and opens the game there.",
  "permissions": ["storage", "tabs", "notifications"],
  "host_permissions": [
    "https://mjai.ekyu.moe/*",
    "https://haipai-trainer.com/*",
    "https://haipai.ylue.de/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://mjai.ekyu.moe/killerducky/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
